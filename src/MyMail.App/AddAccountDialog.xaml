<ContentDialog
    x:Class="MyMail.App.AddAccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Agregar una cuenta"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick"
    CloseButtonClick="OnCloseClick">

    <!-- Original flow: SelectAccountTypePage → provider sign-in / InternetEmailAdvancedSignInPage. -->
    <Grid MinWidth="420" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Step 1: choose provider -->
        <StackPanel x:Name="ProviderPanel" Spacing="4">
            <TextBlock
                Style="{StaticResource MediumTextStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Margin="0,0,0,8"
                Text="Elige el tipo de cuenta" />
            <Button x:Name="OutlookButton" Style="{StaticResource NavButtonStyle}" Height="56" Click="OnOutlookClick" AutomationProperties.Name="Outlook.com o Microsoft 365">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Style="{StaticResource LucideIconStyle}" FontSize="20" Glyph="{StaticResource IconMail}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource MediumTextStyle}" Text="Outlook.com o Microsoft 365" />
                        <TextBlock Style="{StaticResource SmallTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Cuentas personales y de trabajo o escuela" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button x:Name="GmailButton" Style="{StaticResource NavButtonStyle}" Height="56" Click="OnGmailClick" AutomationProperties.Name="Google">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Style="{StaticResource LucideIconStyle}" FontSize="20" Glyph="{StaticResource IconMail}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource MediumTextStyle}" Text="Google" />
                        <TextBlock Style="{StaticResource SmallTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Gmail y Google Workspace" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource NavButtonStyle}" Height="56" Click="OnYahooClick" AutomationProperties.Name="Yahoo">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Style="{StaticResource LucideIconStyle}" FontSize="20" Glyph="{StaticResource IconMail}" />
                    <TextBlock Style="{StaticResource MediumTextStyle}" VerticalAlignment="Center" Text="Yahoo" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource NavButtonStyle}" Height="56" Click="OnICloudClick" AutomationProperties.Name="iCloud">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Style="{StaticResource LucideIconStyle}" FontSize="20" Glyph="{StaticResource IconMail}" />
                    <TextBlock Style="{StaticResource MediumTextStyle}" VerticalAlignment="Center" Text="iCloud" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource NavButtonStyle}" Height="56" Click="OnOtherClick" AutomationProperties.Name="Otra cuenta">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <FontIcon Style="{StaticResource LucideIconStyle}" FontSize="20" Glyph="{StaticResource IconSettings}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource MediumTextStyle}" Text="Otra cuenta" />
                        <TextBlock Style="{StaticResource SmallTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="IMAP y SMTP" />
                    </StackPanel>
                </StackPanel>
            </Button>
            <InfoBar
                x:Name="OAuthMissingInfo"
                Margin="0,8,0,0"
                Severity="Informational"
                IsClosable="False"
                Title="Inicio de sesión con Microsoft o Google sin configurar"
                Message="Agrega los identificadores de cliente en %LOCALAPPDATA%\MyMail\oauth.json (ver docs/referencia/05-cuentas-y-configuracion.md)." />
        </StackPanel>

        <!-- Step 2 (IMAP-based providers): address, password, servers -->
        <StackPanel x:Name="PasswordPanel" Spacing="12" Visibility="Collapsed">
            <TextBlock
                x:Name="PasswordHint"
                Style="{StaticResource SmallTextStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                TextTrimming="None" />
            <TextBox x:Name="EmailBox" Header="Dirección de correo" PlaceholderText="nombre@ejemplo.com" InputScope="EmailSmtpAddress" LostFocus="OnEmailLostFocus" />
            <PasswordBox x:Name="PasswordBox" Header="Contraseña" />
            <TextBox x:Name="NameBox" Header="Enviar los mensajes con este nombre" />
            <Expander x:Name="AdvancedExpander" Header="Configuración avanzada" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="ImapHostBox" Header="Servidor IMAP" />
                    <NumberBox x:Name="ImapPortBox" Grid.Column="1" Header="Puerto" Value="993" />
                    <TextBox x:Name="SmtpHostBox" Grid.Row="1" Header="Servidor SMTP" />
                    <NumberBox x:Name="SmtpPortBox" Grid.Row="1" Grid.Column="1" Header="Puerto" Value="587" />
                    <TextBox x:Name="UserNameBox" Grid.Row="2" Grid.ColumnSpan="2" Header="Nombre de usuario" />
                </Grid>
            </Expander>
        </StackPanel>

        <!-- Working / waiting for the browser or WAM -->
        <StackPanel x:Name="BusyPanel" Spacing="12" Visibility="Collapsed" VerticalAlignment="Center" Padding="0,24">
            <ProgressRing IsActive="True" />
            <TextBlock
                x:Name="BusyText"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                TextTrimming="None"
                Style="{StaticResource MediumTextStyle}" />
        </StackPanel>

        <InfoBar
            x:Name="ErrorInfo"
            Grid.Row="1"
            Severity="Error"
            IsOpen="False"
            IsClosable="True" />
    </Grid>
</ContentDialog>
