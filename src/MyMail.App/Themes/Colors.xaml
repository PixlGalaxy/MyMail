<!--
  Colors observed in the original app (docs/referencia/03-design-tokens.md).
  Everything else follows the Windows accent color through the Fluent system brushes.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ListItemHoveredBrush" Color="#F3F9FD" />
            <SolidColorBrush x:Key="ListItemPressedBrush" Color="#DEECF9" />
            <SolidColorBrush x:Key="ListItemSelectedBrush" Color="#DEECF9" />
            <SolidColorBrush x:Key="ListItemSelectedHoveredBrush" Color="#CFE4F7" />
            <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PaneBorderBrush" Color="#EDEBE9" />
            <SolidColorBrush x:Key="NavPaneBackgroundBrush" Color="#B3F3F2F1" />
            <SolidColorBrush x:Key="ThumbHoverBrush" Color="#CC666666" />
            <SolidColorBrush x:Key="ThumbPressedBrush" Color="#CC767676" />
            <!-- Apply the original list colors to every ListView. -->
            <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="ListItemHoveredBrush" />
            <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="ListItemPressedBrush" />
            <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="ListItemSelectedBrush" />
            <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="ListItemSelectedHoveredBrush" />
            <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="ListItemPressedBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ListItemHoveredBrush" Color="#0C2031" />
            <SolidColorBrush x:Key="ListItemPressedBrush" Color="#092C47" />
            <SolidColorBrush x:Key="ListItemSelectedBrush" Color="#092C47" />
            <SolidColorBrush x:Key="ListItemSelectedHoveredBrush" Color="#0B3557" />
            <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="PaneBorderBrush" Color="#292827" />
            <SolidColorBrush x:Key="NavPaneBackgroundBrush" Color="#B3252423" />
            <SolidColorBrush x:Key="ThumbHoverBrush" Color="#CC999999" />
            <SolidColorBrush x:Key="ThumbPressedBrush" Color="#CC767676" />
            <!-- Apply the original list colors to every ListView. -->
            <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="ListItemHoveredBrush" />
            <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="ListItemPressedBrush" />
            <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="ListItemSelectedBrush" />
            <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="ListItemSelectedHoveredBrush" />
            <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="ListItemPressedBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ListItemHoveredBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ListItemPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ListItemSelectedHoveredBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PaneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PaneBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NavPaneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ThumbHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ThumbPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
